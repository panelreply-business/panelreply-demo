# Example only. Node does not read this file automatically.
# Keep AI disabled until the owner approves API costs and a server deployment.
AI_DEMO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Generate an access code of 32-256 non-whitespace characters. Never commit it.
DEMO_ACCESS_TOKEN=
# Exact origin only, without a trailing slash. HTTP is allowed only for localhost.
PUBLIC_ORIGIN=http://localhost:10000
# Must be explicitly set to 1-1000 before enabling AI.
# This is an in-memory process limit, not a durable billing limit.
# It resets on restart and applies separately to each instance.
AI_MAX_REQUESTS_PER_PROCESS=0
PORT=10000
